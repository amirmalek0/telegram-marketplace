# Browser requests stay on the frontend origin; Vite proxies them to the API.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_STORAGE_PROXY_TARGET=http://localhost:9000
VITE_STORAGE_SIGNING_HOST=localhost:9000
# Optional comma-separated development hostnames (without scheme or port).
VITE_ALLOWED_HOSTS=
VITE_MINIAPP_URL=http://localhost:3000
