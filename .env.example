BOT_TOKEN=your-telegram-bot-token
# Required when WEBHOOK_URL is configured; not needed for polling.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
# Internal services bind to localhost; the optional HTTPS gateway is public.
HOST_BIND=127.0.0.1
# Host port for the bot webhook server; polling mode does not use it.
BOT_PORT=8081
# API host port. Container-to-container requests use api:8080.
API_PORT=8080
# PostgreSQL credentials for the bundled Docker service.
POSTGRES_USER=tgmp
POSTGRES_PASSWORD=tgmp
POSTGRES_DB=telegram_marketplace
# Host-process connection; keep credentials in sync with POSTGRES_*.
DATABASE_URL=postgres://tgmp:tgmp@localhost:5432/telegram_marketplace?sslmode=disable
# Optional Docker API/bot database URL override, e.g. for an external database.
# Otherwise Compose uses POSTGRES_* and the internal postgres:5432 address.
DOCKER_DATABASE_URL=
# PostgreSQL host port; container-to-container requests use postgres:5432.
POSTGRES_PORT=5432
MINIAPP_PORT=3000
BACKOFFICE_PORT=3001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Optional database consoles: docker compose --profile tools up -d
PGADMIN_PORT=5050
CLOUDBEAVER_PORT=8978

# JWT Secret (for admin authentication - use a strong random string, at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Seed Admin Credentials (used only on first boot to create initial admin)
# Change these for production deployments
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin

# Comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# MinIO / Object Storage — connection
STORAGE_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# Per-entity buckets
# Each entity type gets its own bucket so access policies and lifecycle rules
# can be managed independently.

CATEGORY_ICONS_BUCKET=categories-icons
CATEGORY_ICONS_PUBLIC_URL=/storage/categories-icons

PRODUCT_FILES_BUCKET=product-files
PRODUCT_FILES_PUBLIC_URL=/storage/product-files

PRODUCT_IMAGES_BUCKET=product-images
PRODUCT_IMAGES_PUBLIC_URL=/storage/product-images

# Private profile-photo archive. Do not expose this bucket through /storage.
USER_PROFILE_PHOTOS_BUCKET=user-profile-photos
SHOP_LOGOS_BUCKET=shop-logos
MINIAPP_IMAGES_BUCKET=miniapp-images
# Public browser URL used by the backoffice live Mini App content editor.
MINIAPP_PUBLIC_URL=http://localhost:3000
# Optional HTTPS gateway. Set DNS records for both domains before starting it.
MINIAPP_DOMAIN=shop.example.com
BACKOFFICE_DOMAIN=admin.example.com

# Optional local Vite development proxy settings (Docker overrides these).
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_STORAGE_PROXY_TARGET=http://localhost:9000
VITE_STORAGE_SIGNING_HOST=localhost:9000
# Comma-separated additional development hostnames, without scheme or port.
VITE_ALLOWED_HOSTS=
